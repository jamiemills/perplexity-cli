[importlinter]
root_package = perplexity_cli
include_external_packages = True

[importlinter:contract:1]
name = adapter must not import non-allowed layers
type = forbidden
source_modules =
    perplexity_cli.api
    perplexity_cli.attachments
    perplexity_cli.auth
    perplexity_cli.config
    perplexity_cli.threads
    perplexity_cli.utils
forbidden_modules =
    perplexity_cli.exit_codes
    perplexity_cli.query_runner
    perplexity_cli.query_streaming
    perplexity_cli.services
    perplexity_cli.session_log
    perplexity_cli.cli
    perplexity_cli.command_runner
    perplexity_cli.commands
    perplexity_cli.completion_commands
    perplexity_cli.error_handler
    perplexity_cli.formatting
    perplexity_cli.help_json
    perplexity_cli.mcp_server
    perplexity_cli.runners

[importlinter:contract:2]
name = application must not import non-allowed layers
type = forbidden
source_modules =
    perplexity_cli.exit_codes
