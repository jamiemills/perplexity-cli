{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quality/schemas/mutation-report-v1.json",
  "title": "Mutation Testing Report v1",
  "description": "Machine-readable mutation testing result produced by scripts/mutation_policy.py consuming mutmut 3.5.0 internal .meta metadata.",
  "type": "object",
  "required": [
    "schema_version",
    "timestamp",
    "mutmut_version_required",
    "summary",
    "files",
    "policy_pass",
    "violations"
  ],
  "properties": {
    "schema_version": {
      "const": "1",
      "description": "Schema version for forward compatibility."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when the report was generated."
    },
    "head_sha": {
      "type": "string",
      "description": "Git HEAD SHA from which this report was produced."
    },
    "mutmut_version_required": {
      "const": "3.5.0",
      "description": "The exact mutmut version this policy tool is pinned to. Any other version is a schema-drift failure."
    },
    "mutmut_version_found": {
      "type": "string",
      "description": "The version of mutmut actually installed at report time."
    },
    "manifest": {
      "description": "The mutation manifest (changed files, deletions, renames) produced by discover_mutate_diff_files.",
      "type": "object",
      "properties": {
        "schema_version": { "const": "1" },
        "changed_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deletions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "renames": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "old": { "type": "string" },
              "new": { "type": "string" }
            },
            "required": ["old", "new"]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Aggregated counts of mutant outcomes across all files.",
      "required": [
        "total",
        "killed",
        "survived",
        "no_tests",
        "suspicious",
        "timeout",
        "skipped",
        "segfault",
        "not_checked",
        "check_was_interrupted_by_user",
        "caught_by_type_check"
      ],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "killed": { "type": "integer", "minimum": 0 },
        "survived": { "type": "integer", "minimum": 0 },
        "no_tests": { "type": "integer", "minimum": 0 },
        "suspicious": { "type": "integer", "minimum": 0 },
        "timeout": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "segfault": { "type": "integer", "minimum": 0 },
        "not_checked": { "type": "integer", "minimum": 0 },
        "check_was_interrupted_by_user": { "type": "integer", "minimum": 0 },
        "caught_by_type_check": { "type": "integer", "minimum": 0 },
        "tests_collected": { "type": "integer", "minimum": 0 },
        "tests_run": { "type": "integer", "minimum": 0 }
      }
    },
    "files": {
      "type": "array",
      "description": "Per-file mutation results.",
      "items": {
        "type": "object",
        "required": ["path", "mutants"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Original source file path."
          },
          "mutants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "status", "exit_code"],
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Fully-qualified mutant key."
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "killed",
                    "survived",
                    "no tests",
                    "suspicious",
                    "timeout",
                    "skipped",
                    "segfault",
                    "not checked",
                    "check was interrupted by user",
                    "caught by type check"
                  ]
                },
                "exit_code": {
                  "description": "Raw exit code from test runner (null = not checked).",
                  "anyOf": [
                    { "type": "integer" },
                    { "type": "null" }
                  ]
                },
                "duration_s": {
                  "type": "number",
                  "description": "Elapsed test duration in seconds."
                },
                "waived": {
                  "type": "boolean",
                  "description": "True if this outcome was waived."
                },
                "waiver_reason": {
                  "type": "string",
                  "description": "Reason from the waiver if waived."
                }
              }
            }
          }
        }
      }
    },
    "policy_pass": {
      "type": "boolean",
      "description": "True when every non-waived mutant is killed or caught by type check."
    },
    "violations": {
      "type": "array",
      "description": "Policy violations (non-passing results).",
      "items": {
        "type": "object",
        "required": ["key", "status", "file"],
        "properties": {
          "key": { "type": "string" },
          "status": { "type": "string" },
          "file": { "type": "string" },
          "exit_code": {
            "description": "Raw exit code from test runner.",
            "anyOf": [
              { "type": "integer" },
              { "type": "null" }
            ]
          }
        }
      }
    }
  }
}
